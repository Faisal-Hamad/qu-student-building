# Set these in Vercel → Project → Settings → Environment Variables.
# DATABASE_URL is added automatically when you connect Neon from the Storage tab.
DATABASE_URL=

# One-time secret for creating the dean's account at /setup (any long random text).
SETUP_TOKEN=

# Protects the daily backup job (any long random text). Vercel Cron sends it automatically.
CRON_SECRET=

# Email for activation links and daily backups (e.g. a Gmail account with an App Password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="السكن الطلابي <your-address@gmail.com>"

# Cloudflare R2 bucket for request photos (R2 → Manage API tokens → Object Read & Write on this bucket).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sakan-photos
